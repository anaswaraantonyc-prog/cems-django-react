# CEMS Frontend Environment Variables
# In local development, leave these blank to automatically use the Vite proxy (/api and /media).
# In production, set these to your live backend domain (e.g., https://api.cems.example.com).

VITE_API_BASE_URL=
VITE_MEDIA_BASE_URL=
VITE_BACKEND_URL=http://127.0.0.1:8000
